

#customizations
CONFIG_SYSVIPC=y
CONFIG_LOCALVERSION_AUTO=n
CONFIG_LOCALVERSION="@neoochii"
CONFIG_DEFAULT_HOSTNAME="beyond0lte"



#OverlayFS
CONFIG_OVERLAY_FS=y




#KernelSU-Next
CONFIG_KPROBES=n
CONFIG_KSU=y
CONFIG_OVERLAY_FS=y
CONFIG_KSU_ALLOWLIST_WORKAROUND=y

#Disable security features
CONFIG_UH=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP=n
CONFIG_FIVE=n
CONFIG_SECURITY_DEFEX=n

